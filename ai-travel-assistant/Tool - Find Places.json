      "id": "322435e2-78d6-404c-80e3-778bc60cecc5",
      "name": "Geocoding"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://overpass-api.de/api/interpreter",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "=[out:json]; (   node[\"tourism\"=\"attraction\"](around:10000,{{ $json.lat }},{{ $json.lon }});   way[\"tourism\"=\"attraction\"](around:10000,{{ $json.lat }},{{ $json.lon }});   node[\"tourism\"=\"museum\"](around:10000,{{ $json.lat }},{{ $json.lon }});   way[\"tourism\"=\"museum\"](around:10000,{{ $json.lat }},{{ $json.lon }}); ); out center tags;",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        0
      ],
      "id": "71128854-f484-4dcb-a432-51e4ecb9f1f4",
      "name": "Find Attractions"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const elements = $json.elements || [];\n\nconst places = elements\n  .filter(item => item.tags?.name)\n  .map(item => ({\n    name: item.tags.name,\n    type: item.tags.tourism || \"attraction\",\n    latitude: item.lat ?? item.center?.lat,\n    longitude: item.lon ?? item.center?.lon\n  }))\n  .slice(0, 10);\n\nreturn {\n  places\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

    {
      "parameters": {
        "jsCode": "const emails = $input.first().json.Attendees_GmailS\n    .split(',')\n    .map(e => e.trim())\n    .filter(e => e.length > 0);\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nconst invalidEmails = emails.filter(\n    e => !emailRegex.test(e)\n);\n\nreturn [{\n  totalEmailsCount: emails.length,\n  validEmailsCount: emails.length - invalidEmails.length,\n  emails,\n  invalidEmails\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,

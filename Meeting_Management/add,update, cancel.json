    {
      "parameters": {
        "jsCode": "const newMeeting = $('Edit Fields').first().json;\n\nconst newStart = new Date(newMeeting.DateTime);\nconst newEnd = new Date(\n  newStart.getTime() +\n  newMeeting.durationInMinutes * 60000\n);\n\nlet conflict = false;\n\nfor (const item of $input.all()) {\n\n  const existing = item.json;\n\n  if (!existing[\"Date/Time\"]) continue;\n\n  const exStart = new Date(existing[\"Date/Time\"]);\n\n  const exEnd = new Date(\n    exStart.getTime() +\n    Number(existing[\"Duration(mins)\"]) * 60000\n  );\n\n  const buffer = 60 * 60000;\n\n  if (\n    newStart < new Date(exEnd.getTime() + buffer) &&\n    newEnd > new Date(exStart.getTime() - buffer)\n  ) {\n    conflict = true;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ...newMeeting,\n    conflict\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        224
      ],
      "id": "3553fe4b-94fb-4f06-aaff-2bbb610198c7",
      "name": "Conflict_Detector"
    },

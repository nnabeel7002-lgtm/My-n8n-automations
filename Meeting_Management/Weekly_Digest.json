    {
      "parameters": {
        "jsCode": "const meetings = $input.all();\n\nlet total = meetings.length;\nlet scheduled = 0;\nlet done = 0;\nlet cancelled = 0;\n\nfor (const item of meetings) {\n\n  const status = item.json.Status;\n\n  if (status === 'Scheduled') {\n    scheduled++;\n  }\n\n  if (status === 'Done') {\n    done++;\n  }\n\n  if (\n      status === 'Cancelled' ||\n      status === 'Canceled'\n  ) {\n    cancelled++;\n  }\n}\n\nreturn [{\n  json: {\n    total,\n    scheduled,\n    done,\n    cancelled,\n    digest:\n`Weekly Meeting Summary\n\nTotal Meetings: ${total}\n\nScheduled: ${scheduled}\n\nDone: ${done}\n\nCancelled: ${cancelled}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",

    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  const status = String(item.json.Status || '')\n    .trim()\n    .toLowerCase();\n\n  if (\n      status === 'Done' ||\n      status === 'Cancelled' ||\n      status === 'canceled'\n  ) {\n\n    results.push({\n      json: {\n        row_number: item.json.row_number,\n\n        Title: item.json.Title,\n        Attendees: item.json.Attendees,\n        Attendees_Gmails: item.json.Attendees_Gmails,\n        Gist: item.json.Gist,\n        Status: item.json.Status,\n        ID: item.json.ID,\n        \"Date/Time\": item.json[\"Date/Time\"],\n        \"Duration(mins)\": item.json[\"Duration(mins)\"]\n      }\n    });\n\n  }\n}\n\nreturn results;"
      },

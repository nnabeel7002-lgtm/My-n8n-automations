    {
      "parameters": {
        "promptType": "define",
        "text": "=Username: {{ $json.username }}\n\nFull Name: {{ $json.fullName }}\n\nBiography: {{ $json.biography }}\n\nBusiness Category: {{ $json.businessCategoryName }}\n\nFollowers: {{ $json.followersCount }}\n\nFollowing: {{ $json.followsCount }}\n\nBusiness Account: {{ $json.isBusinessAccount }}\n\nPosts: {{ $json.postsCount }}",
        "options": {
          "systemMessage": "You are an Instagram Lead Qualification Assistant.\n\nAnalyze Instagram business profiles and determine whether the profile could be a potential customer for automation, software, AI, or digital services.\n\nAnalyze:\n- username\n- full name\n- biography\n- business category\n- followers\n- following\n- whether it is a business account\n- number of posts\n\nClassify the lead as:\n\nHOT:\nStrong evidence that the business could need automation, AI, software, or digital services.\n\nWARM:\nPotentially relevant business but no strong evidence of an immediate need.\n\nCOLD:\nUnlikely to be a potential customer.\n\nReturn ONLY valid JSON:\n\n{\n  \"username\": \"\",\n  \"full_name\": \"\",\n  \"business\": \"\",\n  \"industry\": \"\",\n  \"interest\": \"\",\n  \"lead_quality\": \"\",\n  \"reason\": \"\"\n}\n\nDo not use markdown.\nDo not add explanations outside the JSON."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        -144
      ],
      "id": "8c19dd2d-eedb-4c1b-9ddb-de52c8c4ae2f",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "llama3.2:1b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        528,
        80
      ],
      "id": "05397da3-4218-4449-9d3f-1081d1c383bc",
      "name": "Ollama Chat Model",
      "credentials": {
        "ollamaApi": {
          "id": "YEUvzm8MdadnrZrp",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let raw = item.json.output;\n\n  if (!raw) {\n    results.push({\n      json: {\n        valid: false,\n        error: \"No AI output found\"\n      }\n    });\n    continue;\n  }\n\n  try {\n    // Clean common formatting problems from the AI\n    raw = raw\n      .replace(/```json/gi, \"\")\n      .replace(/```/g, \"\")\n      .trim();\n\n    const parsed = JSON.parse(raw);\n\n    results.push({\n      json: {\n        valid: true,\n        username: parsed.username || \"\",\n        full_name: parsed.full_name || \"\",\n        business: parsed.business || \"\",\n        industry: parsed.industry || \"\",\n        interest: parsed.interest || \"\",\n        lead_quality: String(parsed.lead_quality || \"UNKNOWN\").toUpperCase(),\n        reason: parsed.reason || \"\"\n      }\n    });\n\n  } catch (error) {\n    results.push({\n      json: {\n        valid: false,\n        error: \"Invalid JSON from AI\",\n        raw_output: raw\n      }\n    });\n  }\n}\n\nreturn results;"
      },

      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet clicks = 0;\nlet impressions = 0;\nlet conversions = 0;\nlet spend = 0;\n\nfor (const item of rows) {\n  clicks += Number(item.json.Clicks);\n  impressions += Number(item.json.Impressions);\n  conversions += Number(item.json.Conversions);\n  spend += Number(item.json.Spend);\n}\n\nconst ctr = (clicks / impressions) * 100;\nconst cpc = spend / clicks;\nconst conversionRate = (conversions / clicks) * 100;\nconst costPerConversion = spend / conversions;\n\nreturn [{\n  json: {\n    totalClicks: clicks,\n    totalImpressions: impressions,\n    totalConversions: conversions,\n    totalSpend: spend,\n    ctr: ctr.toFixed(2),\n    cpc: cpc.toFixed(2),\n    conversionRate: conversionRate.toFixed(2),\n    costPerConversion: costPerConversion.toFixed(2)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
